{
  "$schema": "http://json-schema.org/schema",
  "cli": "nx",
  "title": "Core Generate API Executor",
  "description": "Generate API code via plugin abstraction",
  "type": "object",
  "properties": {
    "generator": {
      "type": "string",
      "description": "Generator plugin to use (e.g., 'openapi-tools')",
      "default": "openapi-tools"
    },
    "inputSpec": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": { "type": "string" } }
      ],
      "description": "OpenAPI spec path or a map of name->specPath"
    },
    "outputPath": {
      "type": "string",
      "description": "Relative output path"
    },
    "generatorOptions": {
      "type": "object",
      "description": "Plugin-specific options",
      "additionalProperties": true
    },
    "postProcess": {
      "type": "array",
      "description": "Post-processors run in order after successful generation",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Registered post-processor name (built-in: split) or package name"
          },
          "options": {
            "type": "object",
            "description": "Options passed to the post-processor",
            "additionalProperties": true
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["inputSpec", "outputPath"],
  "additionalProperties": true
}
